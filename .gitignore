# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# App bundle build output
build/

# OMC / agent local state
.omc/

# macOS
.DS_Store
*.xcuserstate

# Signing material — never commit private keys / certs
*.p12
*.pem
*.key
*.cer
*.certSigningRequest

# Personal dev notes (kept locally, not published).
# docs/reference/ is the exception: published agent/contributor reference docs.
# (Must ignore docs/* rather than docs/ — git cannot re-include inside an excluded directory.)
docs/*
!docs/reference/

# Agent worktrees / local state
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/prepare-pr
.worktrees/

# Local-only review-gate opt-out (not published)
.no-review-gate

# Cloud service local runtime / secrets
server/.venv/
server/.pytest_cache/
server/**/__pycache__/
server/.vercel/
server/.env
server/.env.*
!server/.env.example
supabase/.temp/
supabase/.branches/

# Generated public distribution packages (signed metadata is tracked).
server/releases/*.zip
