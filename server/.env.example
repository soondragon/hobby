# Server only. Never copy these secrets into the native app or commit a real .env file.
GITHUB_PROFILE_CLIENT_ID=YOUR_PUBLIC_OAUTH_CLIENT_ID
GITHUB_PROFILE_CLIENT_SECRET=YOUR_SERVER_ONLY_OAUTH_SECRET
# Dedicated role; never postgres/service_role. Supply the project CA or sslrootcert=system.
TRAINER_DATABASE_URL=postgresql://trainer_api:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co/postgres?sslmode=verify-full&sslrootcert=system
# Supabase transaction poolers may use trainer_api.PROJECT_REF as the username.
